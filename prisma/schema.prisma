generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// PROFESSOR
// ============================================================

model Professor {
  id         String  @id @default(cuid())
  nome       String
  usuario    String  @unique
  senha      String
  disciplina String?
  email      String?
  ativo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividades Atividade[]
}

// ============================================================
// ALUNO
// ============================================================

model Aluno {
  id      String  @id @default(cuid())
  nome    String
  usuario String  @unique
  senha   String
  idade   Int?
  ativo   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entregas Entrega[]
}

// ============================================================
// ATIVIDADE
// ============================================================

model Atividade {
  id          String    @id @default(cuid())
  titulo      String
  descricao   String?
  professorId String
  disciplina  String?
  semestre    Int?
  prazo       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  arquivos Arquivo[]
  entregas Entrega[]
}

// ============================================================
// ENTREGA
// ============================================================

model Entrega {
  id          String  @id @default(cuid())
  atividadeId String
  alunoId     String
  comentario  String?
  status      String  @default("ENVIADA")
  nota        String?
  feedback    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  arquivos Arquivo[]

  @@unique([atividadeId, alunoId])
}

// ============================================================
// ARQUIVO
// ============================================================

model Arquivo {
  id           String @id @default(cuid())
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  url          String

  mimeType String?
  tamanho  Int?

  atividadeId String?
  entregaId   String?

  createdAt DateTime @default(now())

  atividade Atividade? @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  entrega Entrega? @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}
